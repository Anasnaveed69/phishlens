# Copy to .env and adjust. Never commit .env.
PHISHLENS_DB=data/phishlens.db
PHISHLENS_SAMPLE_DIR=data/samples
PHISHLENS_MODEL=models/model.joblib
# Folder for the audit-log HMAC key (created automatically; keep it outside data/)
PHISHLENS_SECRET_DIR=secrets
# Optional: pin the shipped model so a swapped model file is refused (sha256 of models/model.joblib)
PHISHLENS_MODEL_SHA256=3b78b77e2c8fa0845f49cc6cb769cbfac59b5b3e7dcb8cc77f45ab6533c0b19a
PHISHLENS_SESSION_TTL_MIN=30
PHISHLENS_MAX_UPLOAD_BYTES=2097152
PHISHLENS_MAX_IMPORT_BYTES=20971520
PHISHLENS_MAX_IMPORT_FILES=500
PHISHLENS_LOGIN_RATE=5
PHISHLENS_ANALYZE_RATE=30
# Delete stored raw pages older than N days at startup (0 = keep). Results and reports are kept.
PHISHLENS_RETENTION_DAYS=0
# Interactive API docs at /api/docs (set 0 when sharing the server with others)
PHISHLENS_API_DOCS=1
# Set to 1 only when served over HTTPS (also enables HSTS)
PHISHLENS_COOKIE_SECURE=0
