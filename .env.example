# Copy to .env and adjust. Never commit .env.
PHISHLENS_DB=data/phishlens.db
PHISHLENS_SAMPLE_DIR=data/samples
PHISHLENS_MODEL=models/model.joblib
PHISHLENS_SESSION_TTL_MIN=30
PHISHLENS_MAX_UPLOAD_BYTES=2097152
PHISHLENS_MAX_IMPORT_BYTES=20971520
PHISHLENS_MAX_IMPORT_FILES=500
PHISHLENS_LOGIN_RATE=5
PHISHLENS_ANALYZE_RATE=30
# Set to 1 only when served over HTTPS
PHISHLENS_COOKIE_SECURE=0
